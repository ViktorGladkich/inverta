# Resend (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx

# n8n webhook for lead notifications / auto-reply
N8N_LEAD_WEBHOOK_URL=https://n8n.example.com/webhook/client-request
# Shared secret sent as "X-Webhook-Secret" header — configure the n8n Webhook
# node with Header Auth (name: X-Webhook-Secret) using the same value.
N8N_WEBHOOK_SECRET=generate-with-openssl-rand-hex-32

# Comma-separated list of allowed origins for /api/contact.
# Optional: defaults to https://invertadigital.de,https://www.invertadigital.de
# (the current Vercel deployment URL is always allowed for previews).
CONTACT_ALLOWED_ORIGINS=https://invertadigital.de,https://www.invertadigital.de

# Shared rate limiting across serverless instances (Upstash Redis REST API).
# The Vercel Upstash integration sets KV_REST_API_URL / KV_REST_API_TOKEN,
# which are picked up as well. Without these an in-memory fallback is used.
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxx

# Cloudflare Turnstile bot protection (https://dash.cloudflare.com → Turnstile).
# Enforced only when both are set.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA...
TURNSTILE_SECRET_KEY=0x4AAAAAAA...
